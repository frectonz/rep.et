---
import Layout from "../../layouts/Layout.astro";
import RepCard from "../../components/RepCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { Users, Vote, UserRound, MapPin } from "@lucide/astro";
import {
  parties,
  partySlug,
  getPartyBySlug,
  getByParty,
  getPartyStats,
  regionSlug,
} from "../../lib/data";

export function getStaticPaths() {
  return parties.map((party) => ({
    params: { party: partySlug(party) },
  }));
}

const { party: partyParam } = Astro.params;
const partyName = getPartyBySlug(partyParam);

if (!partyName) {
  return Astro.redirect("/parties");
}

const reps = getByParty(partyName);
const stats = getPartyStats(partyName);
const coordsJson = JSON.stringify(
  reps.map((r) => ({ lat: r.lat, lng: r.lng, name: r.location, slug: r.slug })),
);
---

<Layout title={`${partyName}`} description={`${stats.seats} seats across ${stats.regions.length} regions in Ethiopia's House of Peoples' Representatives.`}>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Parties", href: "/parties" }, { label: partyName }]} />

    <h1 class="text-2xl md:text-3xl font-bold mb-6">{partyName}</h1>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <Users class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">{stats.seats}</p>
        <p class="text-xs text-text-muted">Seats</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <Vote class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">{stats.totalVotes.toLocaleString()}</p>
        <p class="text-xs text-text-muted">Total Votes</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <UserRound class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">{stats.genderSplit.female}</p>
        <p class="text-xs text-text-muted">Women</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <MapPin class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">{stats.regions.length}</p>
        <p class="text-xs text-text-muted">Regions</p>
      </div>
    </div>

    {stats.regions.length > 1 && (
      <div class="bg-card rounded-lg border border-border p-5 mb-8">
        <h2 class="text-lg font-bold mb-3">Region Breakdown</h2>
        <div class="grid items-center gap-x-3 gap-y-2 progress-grid">
          {stats.regions.map((r) => (
            <>
              <a href={`/regions/${regionSlug(r.name)}`} class="text-sm whitespace-nowrap hover:text-accent transition-colors progress-label">{r.name}</a>
              <div class="h-5 bg-callout-bg rounded overflow-hidden">
                <div
                  class="h-full bg-olive rounded"
                  style={`width: ${(r.seats / stats.seats) * 100}%`}
                ></div>
              </div>
              <span class="text-sm text-text-muted text-right">{r.seats}</span>
            </>
          ))}
        </div>
      </div>
    )}

    <div class="bg-card rounded-lg border border-border overflow-hidden mb-8">
      <div class="p-4 border-b border-border">
        <h2 class="text-lg font-bold">Map</h2>
      </div>
      <div id="party-map" class="h-64 md:h-80" data-coords={coordsJson}></div>
    </div>

    <h2 class="text-lg font-bold mb-4">
      Representatives <span class="text-text-muted font-normal">({reps.length})</span>
    </h2>
    <div class="space-y-3">
      {reps
        .sort((a, b) => a.location.localeCompare(b.location))
        .map((rep) => (
          <RepCard rep={rep} />
        ))}
    </div>
  </div>
</Layout>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
<script is:inline>
  (function() {
    var container = document.getElementById('party-map');
    if (!container) return;
    var coords = JSON.parse(container.dataset.coords);

    var bounds = new maplibregl.LngLatBounds();
    coords.forEach(function(c) { bounds.extend([c.lng, c.lat]); });

    var map = new maplibregl.Map({
      container: container,
      style: {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
          }
        },
        layers: [{ id: 'osm', type: 'raster', source: 'osm' }]
      },
      bounds: bounds,
      fitBoundsOptions: { padding: 40 }
    });

    map.addControl(new maplibregl.NavigationControl(), 'top-right');

    map.on('load', function() {
      coords.forEach(function(c) {
        var marker = new maplibregl.Marker({ color: '#c8962d', scale: 0.7 })
          .setLngLat([c.lng, c.lat])
          .addTo(map);

        marker.getElement().style.cursor = 'pointer';
        marker.getElement().addEventListener('click', function() {
          window.location.href = '/representatives/' + c.slug;
        });
      });
    });
  })();
</script>
