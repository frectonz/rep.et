---
import Layout from "../../layouts/Layout.astro";
import RepCard from "../../components/RepCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { Users, Vote, UserRound, Landmark } from "@lucide/astro";
import {
  regions,
  regionSlug,
  getRegionBySlug,
  getByRegion,
  getRegionStats,
} from "../../lib/data";

export function getStaticPaths() {
  return regions.map((region) => ({
    params: { region: regionSlug(region) },
  }));
}

const { region: regionParam } = Astro.params;
const regionName = getRegionBySlug(regionParam);

if (!regionName) {
  return Astro.redirect("/regions");
}

const reps = getByRegion(regionName);
const stats = getRegionStats(regionName);
const coordsJson = JSON.stringify(
  reps.map((r) => ({ lat: r.lat, lng: r.lng, name: r.location, slug: r.slug })),
);

const siteUrl = "https://rep.et";
const regionUrl = `${siteUrl}/regions/${regionParam}`;
const description = `${regionName} region has ${stats.seats} seats in Ethiopia's House of Peoples' Representatives. Browse all elected members, party breakdown, and constituency map.`;
const regionJsonLd = {
  "@context": "https://schema.org",
  "@type": "AdministrativeArea",
  name: regionName,
  url: regionUrl,
  description: description,
  containedInPlace: {
    "@type": "Country",
    name: "Ethiopia",
  },
};
---

<Layout title={`${regionName}`} description={description} jsonLd={regionJsonLd}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Regions", href: "/regions" },
        { label: regionName },
      ]}
    />

    <h1 class="text-2xl md:text-3xl font-bold mb-6">{regionName}</h1>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <Users class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">{stats.seats}</p>
        <p class="text-xs text-text-muted">Seats</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <Vote class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">
          {stats.totalVotes.toLocaleString()}
        </p>
        <p class="text-xs text-text-muted">Total Votes</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <UserRound class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">
          {stats.genderSplit.female}
        </p>
        <p class="text-xs text-text-muted">Women</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4 text-center">
        <Landmark class="w-4 h-4 mx-auto mb-1 text-accent" />
        <p class="text-xl font-bold font-heading text-primary">
          {stats.parties.length}
        </p>
        <p class="text-xs text-text-muted">Parties</p>
      </div>
    </div>

    <div
      class={`grid gap-6 mb-8 items-start ${stats.parties.length > 1 ? "lg:grid-cols-3" : ""}`}
    >
      {
        stats.parties.length > 1 && (
          <div class="bg-card rounded-lg border border-border p-5 lg:col-span-1">
            <h2 class="text-lg font-bold mb-3">Party Breakdown</h2>
            <div class="grid items-center gap-x-3 gap-y-2 progress-grid">
              {stats.parties.map((p) => (
                <>
                  <span class="text-sm whitespace-nowrap progress-label">
                    {p.name}
                  </span>
                  <div class="h-5 bg-callout-bg rounded overflow-hidden">
                    <div
                      class="h-full bg-olive rounded"
                      style={`width: ${(p.seats / stats.seats) * 100}%`}
                    />
                  </div>
                  <span class="text-sm text-text-muted text-right">
                    {p.seats}
                  </span>
                </>
              ))}
            </div>
          </div>
        )
      }

      <div
        class={`bg-card rounded-lg border border-border overflow-hidden ${stats.parties.length > 1 ? "lg:col-span-2" : ""}`}
      >
        <div class="p-4 border-b border-border">
          <h2 class="text-lg font-bold">Map</h2>
        </div>
        <div
          id="region-map"
          class="h-64 md:h-80 lg:h-96"
          data-coords={coordsJson}
        >
        </div>
      </div>
    </div>

    <h2 class="text-lg font-bold mb-4">
      Constituencies <span class="text-text-muted font-normal"
        >({reps.length})</span
      >
    </h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        reps
          .sort((a, b) => a.location.localeCompare(b.location))
          .map((rep) => <RepCard rep={rep} />)
      }
    </div>
  </div>
</Layout>

<link
  rel="stylesheet"
  href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css"
/>
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline
></script>
<script is:inline>
  (function () {
    const container = document.getElementById("region-map");
    if (!container) return;
    const coords = JSON.parse(container.dataset.coords);

    const bounds = new maplibregl.LngLatBounds();
    coords.forEach(function (c) {
      bounds.extend([c.lng, c.lat]);
    });

    const map = new maplibregl.Map({
      container: container,
      style: {
        version: 8,
        sources: {
          osm: {
            type: "raster",
            tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
            tileSize: 256,
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          },
        },
        layers: [{ id: "osm", type: "raster", source: "osm" }],
      },
      bounds: bounds,
      fitBoundsOptions: { padding: 40 },
    });

    map.addControl(new maplibregl.NavigationControl(), "top-right");

    map.on("load", function () {
      coords.forEach(function (c) {
        const marker = new maplibregl.Marker({ color: "#c8962d", scale: 0.7 })
          .setLngLat([c.lng, c.lat])
          .addTo(map);

        marker.getElement().style.cursor = "pointer";
        marker.getElement().addEventListener("click", function () {
          window.location.href = "/representatives/" + c.slug;
        });
      });
    });
  })();
</script>
