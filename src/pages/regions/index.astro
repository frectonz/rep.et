---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { Users, Vote } from "@lucide/astro";
import { regions, getRegionStats } from "../../lib/data";

const stats = regions.map(getRegionStats);
---

<Layout
  title="Regions"
  description="Browse all regions and their elected representatives in Ethiopia's House of Peoples' Representatives (HOPR). View seats, votes, and constituency details."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      crumbs={[{ label: "Home", href: "/" }, { label: "Regions" }]}
    />

    <h1 class="text-2xl md:text-3xl font-bold mb-6">Regions</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        stats.map((s) => (
          <a
            href={`/regions/${s.slug}`}
            class="bg-card rounded-lg border border-border p-5 hover:border-accent transition-colors group"
          >
            <h2 class="text-lg font-bold text-primary group-hover:text-accent transition-colors">
              {s.name}
            </h2>
            <div class="flex gap-4 mt-2 text-sm text-text-muted">
              <span class="inline-flex items-center gap-1">
                <Users class="w-3.5 h-3.5" /> {s.seats} seats
              </span>
              <span class="inline-flex items-center gap-1">
                <Vote class="w-3.5 h-3.5" /> {s.totalVotes.toLocaleString()}{" "}
                votes
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
