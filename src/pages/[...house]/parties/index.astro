---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SeatChart from "@/components/SeatChart.astro";
import PartyChips from "@/components/PartyChips.astro";
import { partySlug } from "@/lib/data";
import { getHouse, housePaths, representativesHref } from "@/lib/houses";
import { ArrowRight } from "@lucide/astro";

export function getStaticPaths() {
  return housePaths(() => [{}]);
}

const house = getHouse(Astro.params.house);
const stats = house.parties
  .map(house.getPartyStats)
  .sort((a, b) => b.seats - a.seats || a.name.localeCompare(b.name));
const totalSeats = house.representatives.length;
const pending = house.councilSeats - totalSeats;
const reps = (filters: Parameters<typeof representativesHref>[1]) =>
  representativesHref(house, filters);

const chips = stats.map((party) => ({
  name: party.name,
  color: house.partyColors[party.name],
  count: party.seats,
}));
if (pending > 0) {
  chips.push({
    name: "No result published",
    color: "#b9b0a7",
    count: pending,
  });
}

const share = (seats: number) => ((seats / totalSeats) * 100).toFixed(1);
---

<Layout
  house={house}
  title="Parties"
  description={`See how seats are distributed among political parties in Ethiopia's ${house.fullName} (HOPR). View party statistics and member lists.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      crumbs={[
        { label: "Home", href: house.prefix || "/" },
        { label: "Parties" },
      ]}
    />

    <h1 class="text-2xl md:text-3xl mb-2">Party Breakdown</h1>
    <p class="text-text-muted mb-6">
      {totalSeats} seats held by {stats.length} parties{
        pending > 0 && `, ${pending} seats without a published result`
      }.
    </p>

    <PartyChips chips={chips} interactive class="mb-4" />

    <div
      id="seat-chart-container"
      class="bg-card rounded-xl border border-border p-5 mb-8"
    >
      <SeatChart house={house} class="max-w-3xl mx-auto" />
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        stats.map((party) => (
          <div class="bg-card rounded-xl border border-border p-5 flex flex-col gap-4">
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-lg text-primary leading-snug">
                <a
                  href={`${house.prefix}/parties/${partySlug(party.name)}`}
                  class="hover:text-accent transition-colors"
                >
                  {party.name}
                </a>
              </h2>
              <span class="text-3xl font-heading text-primary tabular-nums leading-none">
                {party.seats}
              </span>
            </div>

            <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
              <div>
                <dt class="text-xs uppercase tracking-wider text-text-muted">
                  Share of seats
                </dt>
                <dd class="tabular-nums">{share(party.seats)}%</dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-wider text-text-muted">
                  Votes
                </dt>
                <dd class="tabular-nums">
                  {party.totalVotes.toLocaleString()}
                </dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-wider text-text-muted">
                  Women · Men
                </dt>
                <dd class="tabular-nums">
                  <a
                    href={reps({ party: party.name, gender: "Female" })}
                    class="hover:text-accent"
                  >
                    {party.genderSplit.female}
                  </a>
                  {" · "}
                  <a
                    href={reps({ party: party.name, gender: "Male" })}
                    class="hover:text-accent"
                  >
                    {party.genderSplit.male}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="text-xs uppercase tracking-wider text-text-muted">
                  Regions
                </dt>
                <dd class="tabular-nums">{party.regions.length}</dd>
              </div>
            </dl>

            <a
              href={reps({ party: party.name })}
              class="mt-auto inline-flex items-center gap-1 text-sm text-accent-deep hover:text-accent-hover"
            >
              All {party.seats === 1 ? "member" : "members"}
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  const container = document.getElementById("seat-chart-container");
  const chips = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".party-chip"),
  );
  const seats = Array.from(
    container?.querySelectorAll<SVGGElement>(".seat") ?? [],
  );
  const pinned = new Set<string>();
  let hovered: string | null = null;

  function paint() {
    const active = new Set(pinned);
    if (hovered && !pinned.has(hovered)) active.add(hovered);
    seats.forEach((seat) => {
      const party = seat.dataset.party ?? "";
      seat.classList.toggle(
        "highlighted",
        active.size > 0 && active.has(party),
      );
      seat.classList.toggle("dimmed", active.size > 0 && !active.has(party));
    });
    chips.forEach((chip) => {
      const on = pinned.has(chip.dataset.party ?? "");
      chip.setAttribute("aria-pressed", on ? "true" : "false");
      chip.classList.toggle("opacity-50", pinned.size > 0 && !on);
    });
  }

  chips.forEach((chip) => {
    const party = chip.dataset.party ?? "";
    chip.addEventListener("click", () => {
      if (pinned.has(party)) pinned.delete(party);
      else pinned.add(party);
      paint();
    });
    chip.addEventListener("mouseenter", () => {
      hovered = party;
      paint();
    });
    chip.addEventListener("mouseleave", () => {
      hovered = null;
      paint();
    });
  });
</script>
