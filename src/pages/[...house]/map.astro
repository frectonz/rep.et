---
import Layout from "@/layouts/Layout.astro";
import MapView from "@/components/Map.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getHouse, housePaths } from "@/lib/houses";

export function getStaticPaths() {
  return housePaths(() => [{}]);
}

const house = getHouse(Astro.params.house);
---

<Layout
  house={house}
  title="Map"
  description={`Interactive map of all ${house.representatives.length} constituencies in Ethiopia's ${house.fullName} (HOPR). Find your elected member of parliament by location.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs
      crumbs={[{ label: "Home", href: house.prefix || "/" }, { label: "Map" }]}
    />

    <h1 class="text-2xl md:text-3xl mb-6">Map</h1>

    <MapView house={house} />
  </div>
</Layout>
