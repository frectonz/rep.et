---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { house6, house7 } from "@/lib/houses";
---

<Layout
  title="About"
  description="Learn about rep.et — an independent civic tool for exploring Ethiopia's House of Peoples' Representatives (HOPR), its elected members, and constituency data."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "About" }]} />

    <h1 class="text-2xl md:text-3xl mb-6">About rep.et</h1>

    <div class="grid lg:grid-cols-2 gap-6 items-start">
      <div class="bg-card rounded-xl border border-border p-6">
        <h2 class="text-xl mb-3">What is HOPR?</h2>
        <p class="text-text-muted leading-relaxed">
          The House of Peoples' Representatives (HOPR) is the highest
          legislative body in the country, with members directly elected by the
          people from single-member constituencies across Ethiopia's regions for
          a five-year term. Representatives are responsible for enacting
          legislation, approving the federal budget, and overseeing the
          executive branch.
        </p>
      </div>

      <div class="bg-card rounded-xl border border-border p-6">
        <h2 class="text-xl mb-3">What This Site Does</h2>
        <p class="text-text-muted leading-relaxed">
          rep.et helps citizens find their elected representative in the House
          of Peoples' Representatives. You can use your device's location to
          find the nearest constituency, search by name or location, or browse
          representatives by region and party. It covers the current <a
            href="/"
            class="text-link underline">{house7.fullName}</a
          > and keeps the <a href="/6th" class="text-link underline"
            >{house6.fullName}</a
          > as an archive.
        </p>
      </div>

      <div class="bg-card rounded-xl border border-border p-6">
        <h2 class="text-xl mb-3">Data</h2>
        <div class="space-y-3 text-text-muted leading-relaxed">
          <p>
            Everything comes from the official election results published by the <a
              href="https://nebe.org.et/"
              class="text-link underline"
              target="_blank"
              rel="noopener noreferrer"
              >National Election Board of Ethiopia (NEBE)</a
            >.
          </p>
          <p>
            Constituency coordinates are approximate points, not official
            boundaries, so the "find your representative" feature uses a
            nearest-point approximation and may not be accurate at constituency
            borders.
          </p>
        </div>
      </div>

      <div class="bg-callout-bg border border-callout-border rounded-xl p-6">
        <h2 class="text-xl mb-3 text-primary">Disclaimer</h2>
        <div class="space-y-3 text-text-muted leading-relaxed">
          <p>
            This is an independent, unofficial project. It is not affiliated
            with or endorsed by the Ethiopian government, NEBE, or any political
            party.
          </p>
          <p>
            This is an open-source civic experiment, not an official government
            service. The data is provided as-is for informational purposes.
            While we strive for accuracy, we cannot guarantee that all
            information is complete or error-free.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
