---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  MapPinned,
  MapPin,
  Globe,
  Landmark,
  User,
  Vote,
  Share2,
  X,
} from "@lucide/astro";
import {
  representatives,
  getBySlug,
  regionSlug,
  formatPlace,
} from "../../lib/data";

export function getStaticPaths() {
  return representatives.map((rep) => ({
    params: { slug: rep.slug },
  }));
}

const { slug } = Astro.params;
const rep = getBySlug(slug);

if (!rep) {
  return Astro.redirect("/representatives");
}

const place = formatPlace(rep);
---

<Layout title={`${rep.candidate}`} description={`${rep.candidate}, representative for ${rep.location} in ${rep.region}. ${rep.party}.`}>
  <div class="max-w-3xl mx-auto px-4 py-8">
    <Breadcrumbs crumbs={[{ label: "Home", href: "/" }, { label: "Representatives", href: "/representatives" }, { label: rep.candidate }]} />

    <div id="share-card" class="relative bg-callout-bg rounded-lg border border-callout-border px-4 py-4 mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <button id="share-dismiss" class="absolute -top-2 -right-2 bg-callout-bg border border-callout-border rounded-full text-text-muted hover:text-text cursor-pointer p-0.5">
        <X class="w-3.5 h-3.5" />
      </button>
      <div>
        <p class="font-medium">Is this your representative?</p>
        <p class="text-sm text-text-muted">Share how you found out!</p>
      </div>
      <button
        id="share-btn"
        data-name={rep.candidate}
        data-location={rep.location}
        data-region={rep.region}
        class="self-end inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white font-medium px-5 py-2.5 rounded-lg transition-colors cursor-pointer shrink-0"
      >
        <Share2 class="w-4 h-4" />
        Share
      </button>
    </div>

    <div class="bg-card rounded-lg border border-border p-6 md:p-8">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 mb-6">
        {rep.image && (
          <img
            src={rep.image}
            alt={rep.candidate}
            width={80}
            height={80}
            fetchpriority="high"
            decoding="async"
            class="w-20 h-20 rounded-full object-cover border-2 border-border shrink-0"
          />
        )}
        <h1 class="text-2xl md:text-3xl font-bold">{rep.candidate}</h1>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <div class="flex items-center gap-2">
            <MapPinned class="w-4 h-4 text-accent shrink-0" />
            <span class="text-xs uppercase tracking-wider text-text-muted">Constituency</span>
          </div>
          <p class="font-medium pl-6">{rep.location}</p>
        </div>

        <div>
          <div class="flex items-center gap-2">
            <Globe class="w-4 h-4 text-accent shrink-0" />
            <span class="text-xs uppercase tracking-wider text-text-muted">Region</span>
          </div>
          <p class="pl-6">
            <a href={`/regions/${regionSlug(rep.region)}`} class="font-medium hover:text-accent">
              {rep.region}
            </a>
          </p>
        </div>

        <div>
          <div class="flex items-center gap-2">
            <Landmark class="w-4 h-4 text-accent shrink-0" />
            <span class="text-xs uppercase tracking-wider text-text-muted">Party</span>
          </div>
          <p class="font-medium pl-6">{rep.party}</p>
        </div>

        <div>
          <div class="flex items-center gap-2">
            <User class="w-4 h-4 text-accent shrink-0" />
            <span class="text-xs uppercase tracking-wider text-text-muted">Gender</span>
          </div>
          <p class="font-medium pl-6">{rep.gender}</p>
        </div>

        <div>
          <div class="flex items-center gap-2">
            <Vote class="w-4 h-4 text-accent shrink-0" />
            <span class="text-xs uppercase tracking-wider text-text-muted">Votes</span>
          </div>
          <p class="font-medium text-lg pl-6">{rep.votes.toLocaleString()}</p>
        </div>

        {place && (
          <div>
            <div class="flex items-center gap-2">
              <MapPin class="w-4 h-4 text-accent shrink-0" />
              <span class="text-xs uppercase tracking-wider text-text-muted">Location</span>
            </div>
            <p class="font-medium pl-6">{place}</p>
          </div>
        )}
      </div>
    </div>

    <div class="mt-6 bg-card rounded-lg border border-border overflow-hidden">
      <div class="p-4 border-b border-border">
        <h2 class="text-lg font-bold">Location</h2>
      </div>
      <div
        id="rep-map"
        class="h-64 md:h-80"
        data-lat={rep.lat}
        data-lng={rep.lng}
        data-name={rep.location}
      ></div>
    </div>
  </div>
</Layout>

<script is:inline>
  (function() {
    var card = document.getElementById('share-card');
    var btn = document.getElementById('share-btn');
    var dismiss = document.getElementById('share-dismiss');
    if (!card || !btn) return;

    if (!navigator.share) {
      card.style.display = 'none';
      return;
    }

    dismiss.addEventListener('click', function() {
      card.remove();
    });

    btn.addEventListener('click', function() {
      var name = btn.dataset.name;
      var location = btn.dataset.location;
      var region = btn.dataset.region;

      navigator.share({
        title: name,
        text: 'I just found out that my representative in the HoPR is ' + name + ' from ' + location + ', ' + region + '!\n\nFind yours at rep.et\n\n' + window.location.href
      });
    });
  })();
</script>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
<script is:inline>
  (function() {
    var container = document.getElementById('rep-map');
    if (!container) return;
    var lat = parseFloat(container.dataset.lat);
    var lng = parseFloat(container.dataset.lng);
    var name = container.dataset.name;

    var map = new maplibregl.Map({
      container: container,
      style: {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
          }
        },
        layers: [{ id: 'osm', type: 'raster', source: 'osm' }]
      },
      center: [lng, lat],
      zoom: 10
    });

    new maplibregl.Marker({ color: '#c8962d' })
      .setLngLat([lng, lat])
      .addTo(map);

    map.addControl(new maplibregl.NavigationControl(), 'top-right');
  })();
</script>
