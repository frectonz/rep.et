---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import EthiopicBg from "@/components/EthiopicBg.astro";
import { pwaInfo } from "virtual:pwa-info";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  centerContent?: boolean;
}

const {
  title = "Find Your Representative",
  description = "Find your representative in Ethiopia's House of Peoples' Representatives (HOPR). Search 471 elected members of parliament by name, region, party, or location.",
  canonicalPath,
  ogType = "website",
  jsonLd,
  centerContent = false,
} = Astro.props;

const siteUrl = "https://rep.et";
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, siteUrl).href
  : new URL(Astro.url.pathname, siteUrl).href;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "index";
const ogPath = pathname === "index" ? "/og/index.png" : `/og${pathname}.png`;
const ogImageUrl = new URL(ogPath, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3d2b1f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="rep.et" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="rep.et" />
    <meta property="og:locale" content="en_ET" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <title>{title}</title>
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    <slot name="head" />
    {import.meta.env.PROD && <script is:inline src="/registerSW.js" />}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main
      class:list={["flex-1 relative bg-bg", centerContent && "flex flex-col"]}
    >
      <EthiopicBg />
      <div class:list={["relative", centerContent && "flex-1 flex flex-col"]}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
