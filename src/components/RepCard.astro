---
import type { Representative } from "../lib/data";

interface Props {
  rep: Representative;
}

const { rep } = Astro.props;
---

<a
  href={`/representatives/${rep.slug}`}
  class="block bg-card rounded-lg border border-border hover:border-accent transition-colors p-4"
>
  <div class="flex items-center justify-between gap-4">
    <div class="min-w-0">
      <h2 class="text-primary truncate">{rep.candidate}</h2>
      <p class="text-sm text-text-muted mt-0.5">{rep.location}</p>
      <div class="flex flex-wrap gap-2 mt-2">
        <span
          class="inline-block text-xs px-2 py-0.5 rounded-full bg-callout-bg text-earth"
        >
          {rep.region}
        </span>
        <span
          class="inline-block text-xs px-2 py-0.5 rounded-full bg-callout-bg text-olive"
        >
          {rep.party}
        </span>
        <span
          class="inline-block text-xs px-2 py-0.5 rounded-full bg-callout-bg text-text-muted"
        >
          {rep.gender}
        </span>
      </div>
    </div>
    <div class="text-right shrink-0">
      <span class="text-sm font-medium text-text-muted">
        {rep.votes.toLocaleString()}
      </span>
      <span class="block text-xs text-text-muted">votes</span>
    </div>
  </div>
</a>
