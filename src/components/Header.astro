---
import { Info, Landmark, Map, Moon, Sun, Users } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import type { House } from "@/lib/houses";

interface Props {
  house: House;
}

const { house } = Astro.props;

const navLinks = [
  {
    href: `${house.prefix}/representatives`,
    label: "Representatives",
    icon: Users,
  },
  { href: `${house.prefix}/parties`, label: "Parties", icon: Landmark },
  { href: `${house.prefix}/map`, label: "Map", icon: Map },
  { href: "/about", label: "About", icon: Info },
];

const currentPath = Astro.url.pathname;

const navLink = (href: string) =>
  currentPath.startsWith(href)
    ? "text-accent flex items-center gap-1.5"
    : "text-white/80 hover:text-accent transition-colors flex items-center gap-1.5";
---

<header
  class="bg-header-bg text-white sticky top-0 z-50 border-b border-border/20"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4"
  >
    <a
      href={house.prefix || "/"}
      class="flex flex-col leading-tight text-white hover:opacity-80 transition-opacity"
    >
      <span class="text-xl font-heading tracking-tight">rep.et</span>
      <span
        class="text-xs opacity-60 -mt-1"
        style="font-family: 'Nyala', serif;">ተወካዮች</span
      >
    </a>

    <nav class="flex items-center gap-3 sm:gap-4 lg:gap-6 text-sm">
      {
        navLinks.map((link) => (
          <a href={link.href} class={navLink(link.href)}>
            <link.icon class="w-4 h-4" />
            <span class="sr-only lg:not-sr-only">{link.label}</span>
          </a>
        ))
      }
      <a
        href="https://github.com/frectonz/rep.et"
        target="_blank"
        rel="noopener noreferrer"
        class="text-white/80 hover:text-accent transition-colors flex items-center gap-1.5"
        aria-label="Source code on GitHub"
      >
        <Icon name="simple-icons:github" class="w-4 h-4" />
        <span class="sr-only lg:not-sr-only">GitHub</span>
      </a>
      <button
        type="button"
        id="theme-toggle"
        class="text-white/80 hover:text-accent transition-colors flex items-center gap-1.5 cursor-pointer"
        aria-label="Switch to dark mode"
        aria-pressed="false"
        title="Switch to dark mode"
      >
        <Sun class="w-4 h-4 hidden dark:block" />
        <Moon class="w-4 h-4 block dark:hidden" />
        <span id="theme-toggle-label" class="hidden lg:inline">Dark mode</span>
        <span class="sr-only">Switch to dark mode</span>
      </button>
    </nav>
  </div>
</header>

<script>
  function setupThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!(toggle instanceof HTMLButtonElement) || toggle.dataset.ready) return;
    toggle.dataset.ready = "true";

    const updateThemeMeta = (isDark: boolean) => {
      document
        .querySelectorAll('meta[name="theme-color"]:not([media])')
        .forEach((meta) => {
          meta.setAttribute("content", isDark ? "#16110e" : "#3d2b1f");
        });
    };

    const updateButton = () => {
      const isDark = document.documentElement.classList.contains("dark");
      const label = isDark ? "Switch to light mode" : "Switch to dark mode";
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("aria-pressed", isDark ? "true" : "false");
      toggle.title = label;
      const visibleLabel = toggle.querySelector("#theme-toggle-label");
      if (visibleLabel) {
        visibleLabel.textContent = isDark ? "Light mode" : "Dark mode";
      }
      const text = toggle.querySelector(".sr-only");
      if (text) text.textContent = label;
    };

    updateButton();
    toggle.addEventListener("click", () => {
      const isDark = !document.documentElement.classList.contains("dark");
      document.documentElement.classList.toggle("dark", isDark);
      localStorage.setItem("theme", isDark ? "dark" : "light");
      updateThemeMeta(isDark);
      updateButton();
      window.dispatchEvent(new CustomEvent("theme-change"));
    });
  }

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>
