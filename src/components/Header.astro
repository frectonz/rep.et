---
import {
  ChartColumn,
  Globe,
  Info,
  Landmark,
  Map,
  Menu,
  Users,
} from "@lucide/astro";

const navLinks = [
  { href: "/representatives", label: "Representatives", icon: Users },
  { href: "/regions", label: "Regions", icon: Globe },
  { href: "/parties", label: "Parties", icon: Landmark },
  { href: "/map", label: "Map", icon: Map },
  { href: "/stats", label: "Stats", icon: ChartColumn },
  { href: "/about", label: "About", icon: Info },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-primary text-white sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between">
    <a
      href="/"
      class="flex flex-col leading-tight text-white hover:opacity-80 transition-opacity"
    >
      <span class="text-xl font-bold font-heading tracking-tight">rep.et</span>
      <span
        class="text-xs opacity-60 -mt-1"
        style="font-family: 'Nyala', serif;">ተወካዮች</span
      >
    </a>

    <button
      id="menu-toggle"
      class="md:hidden p-2 text-white"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <Menu class="w-6 h-6" />
    </button>

    <nav id="nav-menu" class="hidden md:flex items-center gap-6">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm transition-colors inline-flex items-center gap-1.5",
              currentPath.startsWith(link.href)
                ? "text-accent font-semibold"
                : "text-white/80 hover:text-white",
            ]}
          >
            <link.icon class="w-4 h-4" />
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <nav id="mobile-menu" class="hidden md:hidden border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-col gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm py-2 transition-colors inline-flex items-center gap-2",
              currentPath.startsWith(link.href)
                ? "text-accent font-semibold"
                : "text-white/80 hover:text-white",
            ]}
          >
            <link.icon class="w-4 h-4" />
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const expanded = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!expanded));
    menu?.classList.toggle("hidden");
  });
</script>
