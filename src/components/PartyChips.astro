---
interface Chip {
  name: string;
  color: string;
  count: number;
  href?: string;
}

interface Props {
  chips: Chip[];
  interactive?: boolean;
  class?: string;
}

const { chips, interactive = false, class: cls = "" } = Astro.props;

const base =
  "inline-flex shrink-0 items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-sm text-text transition-all hover:border-accent";
---

<div
  class:list={[
    "flex gap-2 overflow-x-auto pb-2 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap sm:overflow-visible",
    cls,
  ]}
>
  {
    chips.map((chip) =>
      interactive ? (
        <button
          type="button"
          class:list={[
            base,
            "party-chip cursor-pointer aria-pressed:bg-primary aria-pressed:border-primary aria-pressed:text-white",
          ]}
          data-party={chip.name}
          aria-pressed="false"
        >
          <span
            class="w-2.5 h-2.5 rounded-full shrink-0"
            style={`background:${chip.color}`}
          />
          {chip.name}
          <span class="chip-count text-text-muted tabular-nums">
            {chip.count}
          </span>
        </button>
      ) : (
        <a href={chip.href} class={base}>
          <span
            class="w-2.5 h-2.5 rounded-full shrink-0"
            style={`background:${chip.color}`}
          />
          {chip.name}
          <span class="text-text-muted tabular-nums">{chip.count}</span>
        </a>
      ),
    )
  }
</div>
