---
import PartyChips from "@/components/PartyChips.astro";
import type { House } from "@/lib/houses";

interface Props {
  house: House;
}

const { house } = Astro.props;

const geojson = JSON.stringify({
  type: "FeatureCollection",
  features: house.representatives.map((r) => ({
    type: "Feature",
    geometry: {
      type: "Point",
      coordinates: [r.lng, r.lat],
    },
    properties: {
      candidate: r.candidate,
      location: r.location,
      region: r.region,
      party: r.party,
      votes: r.votes,
      href: r.href,
    },
  })),
});

const PARTY_COLORS = house.partyColors;
const chips = house.parties
  .map((p) => ({
    name: p,
    color: PARTY_COLORS[p],
    count: house.getByParty(p).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<style is:global>
  .maplibregl-popup-content {
    font-family: Georgia, "Times New Roman", serif;
    min-width: 280px;
    padding: 0 !important;
    border-radius: 12px !important;
    overflow: hidden;
    box-shadow: 0 6px 24px rgba(44, 24, 16, 0.18);
    border: 1px solid #d9cfc5;
  }
  .maplibregl-popup-close-button {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.7);
    padding: 4px 10px;
    right: 0;
    top: 0;
    z-index: 1;
  }
  .maplibregl-popup-close-button:hover {
    color: #fff;
    background: transparent;
  }
  .popup-header {
    background: #3d2b1f;
    padding: 14px 16px;
  }
  .popup-candidate {
    font-weight: bold;
    font-size: 16px;
    color: #fff;
    margin: 0 0 2px;
  }
  .popup-location-line {
    display: flex;
    align-items: center;
    gap: 5px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
  }
  .popup-location-line svg {
    flex-shrink: 0;
    opacity: 0.7;
  }
  .popup-body {
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .popup-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13px;
    color: #2c1810;
  }
  .popup-row svg {
    flex-shrink: 0;
    color: #c8962d;
    align-self: center;
  }
  .popup-row-label {
    color: #6b5d52;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .popup-row-value {
    font-weight: 600;
    color: #3d2b1f;
  }
  .popup-party-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .popup-footer {
    padding: 0 16px 14px;
  }
  .popup-link {
    display: block;
    text-align: center;
    background: #c8962d;
    color: #fff;
    font-weight: 600;
    font-size: 13px;
    padding: 9px 16px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s;
  }
  .popup-link:hover {
    background: #a87b24;
  }
</style>

<div class="mb-4">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 mb-2">
    <p class="text-sm text-text-muted">
      {house.representatives.length} constituencies
    </p>
    <button
      type="button"
      id="legend-reset"
      class="text-sm font-medium text-accent-deep hover:text-accent-hover transition-colors cursor-pointer"
      hidden
    >
      Show all parties
    </button>
  </div>
  <PartyChips chips={chips} interactive />
</div>

<div
  id="full-map"
  class="w-full h-[70vh] min-h-[360px] rounded-xl border border-border overflow-hidden bg-card"
  data-geojson={geojson}
  data-colors={JSON.stringify(PARTY_COLORS)}
>
</div>

<script>
  import type {
    ExpressionSpecification,
    MapLayerMouseEvent,
  } from "maplibre-gl";
  import { escapeHtml } from "@/lib/html";
  import {
    createMap,
    maplibregl,
    ETHIOPIA_CENTER,
    ETHIOPIA_ZOOM,
  } from "@/lib/map";

  interface Props {
    candidate: string;
    location: string;
    region: string;
    party: string;
    votes: number | null;
    href: string;
  }

  const container = document.getElementById("full-map")!;
  interface Feature {
    type: "Feature";
    geometry: { type: "Point"; coordinates: [number, number] };
    properties: Props;
  }

  const data: { type: "FeatureCollection"; features: Feature[] } = JSON.parse(
    container.dataset.geojson!,
  );
  const colors: Record<string, string> = JSON.parse(container.dataset.colors!);

  const ICON_PIN =
    '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>';
  const ICON_LANDMARK =
    '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" x2="21" y1="22" y2="22"/><line x1="6" x2="6" y1="18" y2="11"/><line x1="10" x2="10" y1="18" y2="11"/><line x1="14" x2="14" y1="18" y2="11"/><line x1="18" x2="18" y1="18" y2="11"/><polygon points="12 2 20 7 4 7"/></svg>';
  const ICON_VOTE =
    '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"/><path d="M5 7c0-1.1.9-2 2-2h10a2 2 0 0 1 2 2v12H5V7Z"/><path d="M22 19H2"/></svg>';

  function popupHtml(p: Props): string {
    const votes = p.votes == null ? "N/A" : Number(p.votes).toLocaleString();
    return `
      <div class="popup-header">
        <div class="popup-candidate">${escapeHtml(p.candidate)}</div>
        <div class="popup-location-line">${ICON_PIN} ${escapeHtml(p.location)} &middot; ${escapeHtml(p.region)}</div>
      </div>
      <div class="popup-body">
        <div class="popup-row">${ICON_LANDMARK}
          <span class="popup-party-dot" style="background:${colors[p.party] ?? "#9e9e9e"}"></span>
          <span class="popup-row-value">${escapeHtml(p.party)}</span>
        </div>
        <div class="popup-row">${ICON_VOTE}
          <span class="popup-row-label">Votes</span>
          <span class="popup-row-value">${votes}</span>
        </div>
      </div>
      <div class="popup-footer">
        <a href="${p.href}" class="popup-link">View profile &rarr;</a>
      </div>`;
  }

  const map = createMap(container, {
    center: ETHIOPIA_CENTER,
    zoom: ETHIOPIA_ZOOM,
  });

  map.on("load", () => {
    map.addSource("constituencies", { type: "geojson", data });

    const colorMatch = [
      "match",
      ["get", "party"],
      ...Object.entries(colors).flat(),
      "#9e9e9e",
    ] as unknown as ExpressionSpecification;

    map.addLayer({
      id: "constituency-dots",
      type: "circle",
      source: "constituencies",
      paint: {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 5, 10, 9],
        "circle-color": colorMatch,
        "circle-stroke-color": "#fff",
        "circle-stroke-width": 1.5,
        "circle-opacity": 0.85,
      },
    });

    map.on("click", "constituency-dots", (e: MapLayerMouseEvent) => {
      const feature = e.features?.[0];
      if (!feature || feature.geometry.type !== "Point") return;
      new maplibregl.Popup({ offset: 14, maxWidth: "320px" })
        .setLngLat(feature.geometry.coordinates as [number, number])
        .setHTML(popupHtml(feature.properties as Props))
        .addTo(map);
    });

    map.on("mouseenter", "constituency-dots", () => {
      map.getCanvas().style.cursor = "pointer";
    });
    map.on("mouseleave", "constituency-dots", () => {
      map.getCanvas().style.cursor = "";
    });

    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".party-chip"),
    );
    const reset = document.getElementById("legend-reset")!;
    const pinned = new Set<string>();
    let hovered: string | null = null;

    function paint() {
      const active =
        hovered && !pinned.has(hovered) ? [hovered] : Array.from(pinned);
      const isActive: ExpressionSpecification | boolean =
        active.length === 0
          ? true
          : ["in", ["get", "party"], ["literal", active]];
      const emphasis = active.length > 0;
      map.setPaintProperty("constituency-dots", "circle-opacity", [
        "case",
        isActive,
        0.9,
        0.08,
      ]);
      map.setPaintProperty("constituency-dots", "circle-stroke-opacity", [
        "case",
        isActive,
        1,
        0.1,
      ]);
      map.setPaintProperty("constituency-dots", "circle-radius", [
        "interpolate",
        ["linear"],
        ["zoom"],
        5,
        ["case", isActive, emphasis ? 6 : 5, 3],
        10,
        ["case", isActive, emphasis ? 11 : 9, 5],
      ]);
      chips.forEach((chip) => {
        const on = pinned.has(chip.dataset.party ?? "");
        chip.setAttribute("aria-pressed", on ? "true" : "false");
        chip.classList.toggle("opacity-50", pinned.size > 0 && !on);
        chip.querySelector(".chip-count")?.classList.toggle("text-accent", on);
      });
      reset.hidden = pinned.size === 0;
    }

    function flyToPinned() {
      if (pinned.size === 0) {
        map.flyTo({ center: ETHIOPIA_CENTER, zoom: ETHIOPIA_ZOOM });
        return;
      }
      const bounds = new maplibregl.LngLatBounds();
      data.features
        .filter((f: Feature) => pinned.has(f.properties.party))
        .forEach((f: Feature) => bounds.extend(f.geometry.coordinates));
      map.fitBounds(bounds, { padding: 80, maxZoom: 9, duration: 900 });
    }

    chips.forEach((chip) => {
      const party = chip.dataset.party ?? "";
      chip.addEventListener("click", () => {
        if (pinned.has(party)) pinned.delete(party);
        else pinned.add(party);
        paint();
        flyToPinned();
      });
      chip.addEventListener("mouseenter", () => {
        hovered = party;
        paint();
      });
      chip.addEventListener("mouseleave", () => {
        hovered = null;
        paint();
      });
    });

    reset.addEventListener("click", () => {
      pinned.clear();
      hovered = null;
      paint();
      flyToPinned();
    });
  });
</script>
