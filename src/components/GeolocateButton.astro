---
import { representatives } from "../lib/data";
import { MapPin } from "@lucide/astro";

const coordsJson = JSON.stringify(
  representatives.map((r) => ({
    lat: r.lat,
    lng: r.lng,
    slug: r.slug,
    candidate: r.candidate,
    location: r.location,
    region: r.region,
  })),
);
---

<button
  id="locate-btn"
  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-accent hover:bg-accent-hover text-primary rounded-lg transition-colors text-lg cursor-pointer"
>
  <MapPin class="w-5 h-5" />
  Use My Location
</button>

<script is:inline define:vars={{ coordsJson }}>
  document.addEventListener("DOMContentLoaded", function () {
    const reps = JSON.parse(coordsJson);
    const btn = document.getElementById("locate-btn");
    const status = document.getElementById("geo-status");
    const fallback = document.getElementById("geo-fallback");
    const searchInput = document.getElementById("fallback-search");
    const resultsDiv = document.getElementById("fallback-results");

    function haversine(lat1, lng1, lat2, lng2) {
      const R = 6371;
      const toRad = function (d) {
        return (d * Math.PI) / 180;
      };
      const dLat = toRad(lat2 - lat1);
      const dLng = toRad(lng2 - lng1);
      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRad(lat1)) *
          Math.cos(toRad(lat2)) *
          Math.sin(dLng / 2) *
          Math.sin(dLng / 2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function showStatus(msg, isError) {
      status.textContent = msg;
      status.className =
        "mt-4 text-sm text-center " +
        (isError ? "text-red-700" : "text-text-muted");
      status.classList.remove("hidden");
    }

    function showFallback() {
      fallback.classList.remove("hidden");
    }

    btn.addEventListener("click", function () {
      if (!navigator.geolocation) {
        showStatus("Geolocation is not supported by your browser.", true);
        showFallback();
        return;
      }

      btn.textContent = "Locating...";
      btn.disabled = true;
      showStatus("Requesting your location...", false);

      navigator.geolocation.getCurrentPosition(
        function (pos) {
          const userLat = pos.coords.latitude;
          const userLng = pos.coords.longitude;

          let minDist = Infinity;
          let nearest = null;
          for (let i = 0; i < reps.length; i++) {
            const c = reps[i];
            const d = haversine(userLat, userLng, c.lat, c.lng);
            if (d < minDist) {
              minDist = d;
              nearest = c;
            }
          }

          if (nearest) {
            showStatus(
              "Found nearest constituency (" +
                Math.round(minDist) +
                " km away). Redirecting...",
              false,
            );
            window.location.href = "/representatives/" + nearest.slug;
          }
        },
        function (err) {
          btn.textContent = "Use My Location";
          btn.disabled = false;
          let msg = "Could not get your location.";
          if (err.code === 1) msg = "Location access was denied.";
          else if (err.code === 2) msg = "Location unavailable.";
          else if (err.code === 3) msg = "Location request timed out.";
          showStatus(msg, true);
          showFallback();
        },
        { enableHighAccuracy: true, timeout: 10000 },
      );
    });

    // Fallback search
    if (searchInput) {
      searchInput.addEventListener("input", function () {
        const query = searchInput.value.toLowerCase().trim();
        if (!query) {
          resultsDiv.innerHTML = "";
          return;
        }

        const matches = reps
          .filter(function (r) {
            return (
              r.location.toLowerCase().indexOf(query) !== -1 ||
              r.region.toLowerCase().indexOf(query) !== -1 ||
              r.candidate.toLowerCase().indexOf(query) !== -1
            );
          })
          .slice(0, 8);

        resultsDiv.innerHTML = matches
          .map(function (r) {
            return (
              '<a href="/representatives/' +
              r.slug +
              '" class="block px-3 py-2 rounded text-sm hover:bg-[#f0e8de] transition-colors">' +
              '<span class="font-medium text-[#3d2b1f]">' +
              r.candidate +
              "</span>" +
              '<span class="text-[#6b5d52]"> — ' +
              r.location +
              ", " +
              r.region +
              "</span>" +
              "</a>"
            );
          })
          .join("");
      });
    }
  });
</script>
