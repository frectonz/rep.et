---
import { representatives } from "../lib/data";

const geojson = JSON.stringify({
  type: "FeatureCollection",
  features: representatives.map((r) => ({
    type: "Feature",
    geometry: {
      type: "Point",
      coordinates: [r.lng, r.lat],
    },
    properties: {
      candidate: r.candidate,
      location: r.location,
      region: r.region,
      party: r.party,
      votes: r.votes,
      slug: r.slug,
    },
  })),
});

const PARTY_COLORS: Record<string, string> = {
  'Prosperity Party': '#3d7a2e',
  'Ethiopian Citizens for Social Justice (EZEMA)': '#9b2c2c',
  'National Movement of Amhara': '#2a6496',
  'Gedio People Democratic Organization': '#d4a017',
  'Kucha People Democratic Party': '#c06a30',
  'Independent': '#8a7d72',
};
const partyColorsJson = JSON.stringify(PARTY_COLORS);
---

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" />

<style>
  .maplibregl-popup-content {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 13px;
    line-height: 1.5;
    min-width: 180px;
    padding: 10px 12px;
    border-radius: 8px;
  }
  .popup-location { font-weight: bold; color: #3d2b1f; }
  .popup-region { color: #7a6b60; }
  .popup-hr { margin: 4px 0; border: none; border-top: 1px solid #d9cfc5; }
  .popup-candidate { font-weight: bold; color: #3d2b1f; }
  .popup-party-dot {
    display: inline-block; width: 8px; height: 8px;
    border-radius: 50%; margin-right: 4px;
  }
</style>

<div id="map-wrapper" style="position:relative;width:100%;height:calc(100vh - 56px);">
  <div id="full-map" style="position:absolute;top:0;left:0;right:0;bottom:0;"></div>
  <div id="legend" style="position:absolute;bottom:45px;right:10px;background:#fff;padding:10px 14px;border-radius:8px;box-shadow:0 1px 5px rgba(0,0,0,0.3);font-size:13px;line-height:1.6;z-index:1;"></div>
</div>

<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js" is:inline></script>
<script is:inline define:vars={{ geojson, partyColorsJson }}>
  var DATA = JSON.parse(geojson);
  var PARTY_COLORS = JSON.parse(partyColorsJson);

  var map = new maplibregl.Map({
    container: 'full-map',
    style: {
      version: 8,
      sources: {
        osm: {
          type: 'raster',
          tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
          tileSize: 256,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }
      },
      layers: [{ id: 'osm', type: 'raster', source: 'osm' }]
    },
    center: [39.5, 9.0],
    zoom: 5.5
  });

  map.addControl(new maplibregl.NavigationControl(), 'top-right');

  map.on('load', function() {
    map.addSource('constituencies', { type: 'geojson', data: DATA });

    var colorMatch = ['match', ['get', 'party']];
    Object.keys(PARTY_COLORS).forEach(function(party) {
      colorMatch.push(party, PARTY_COLORS[party]);
    });
    colorMatch.push('#9e9e9e');

    map.addLayer({
      id: 'constituency-dots',
      type: 'circle',
      source: 'constituencies',
      paint: {
        'circle-radius': ['interpolate', ['linear'], ['zoom'], 5, 5, 10, 9],
        'circle-color': colorMatch,
        'circle-stroke-color': '#fff',
        'circle-stroke-width': 1.5,
        'circle-opacity': 0.85
      }
    });

    map.on('click', 'constituency-dots', function(e) {
      var f = e.features[0];
      var p = f.properties;
      var color = PARTY_COLORS[p.party] || '#9e9e9e';
      var votes = p.votes != null ? Number(p.votes).toLocaleString() : 'N/A';
      new maplibregl.Popup()
        .setLngLat(f.geometry.coordinates)
        .setHTML(
          '<div class="popup-location">' + p.location + '</div>' +
          '<div class="popup-region">' + p.region + '</div>' +
          '<hr class="popup-hr">' +
          '<div class="popup-candidate">' + p.candidate + '</div>' +
          '<div><span class="popup-party-dot" style="background:' + color + '"></span>' + p.party + '</div>' +
          '<div>Votes: <strong>' + votes + '</strong></div>' +
          '<div style="margin-top:6px"><a href="/representatives/' + p.slug + '" style="color:#c8962d;font-weight:600;">View profile &rarr;</a></div>'
        )
        .addTo(map);
    });

    map.on('mouseenter', 'constituency-dots', function() {
      map.getCanvas().style.cursor = 'pointer';
    });
    map.on('mouseleave', 'constituency-dots', function() {
      map.getCanvas().style.cursor = '';
    });
  });

  var legendEl = document.getElementById('legend');
  legendEl.innerHTML = '<h4 style="margin:0 0 6px;font-weight:bold;color:#3d2b1f;">Parties</h4>';
  Object.keys(PARTY_COLORS).forEach(function(party) {
    legendEl.innerHTML +=
      '<div style="display:flex;align-items:center;gap:6px;margin-bottom:2px;">' +
      '<span style="width:12px;height:12px;border-radius:50%;background:' + PARTY_COLORS[party] + ';flex-shrink:0;"></span>' +
      '<span style="color:#2c1810;">' + party + '</span></div>';
  });
</script>
