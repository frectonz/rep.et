---
import { representatives } from "../lib/data";

const geojson = JSON.stringify({
  type: "FeatureCollection",
  features: representatives.map((r) => ({
    type: "Feature",
    geometry: {
      type: "Point",
      coordinates: [r.lng, r.lat],
    },
    properties: {
      candidate: r.candidate,
      location: r.location,
      region: r.region,
      party: r.party,
      votes: r.votes,
      slug: r.slug,
    },
  })),
});
---

<div id="full-map" class="w-full" style="height: calc(100vh - 56px);" data-geojson={geojson}></div>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl/dist/maplibre-gl.css" />

<script>
  import maplibregl from "maplibre-gl";

  const container = document.getElementById("full-map");
  if (container) {
    const geojson = JSON.parse(container.dataset.geojson!);

    const map = new maplibregl.Map({
      container,
      style: "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json",
      center: [39.5, 8.5],
      zoom: 5.5,
    });

    map.addControl(new maplibregl.NavigationControl(), "top-right");

    map.on("load", () => {
      map.addSource("constituencies", {
        type: "geojson",
        data: geojson,
      });

      map.addLayer({
        id: "constituency-dots",
        type: "circle",
        source: "constituencies",
        paint: {
          "circle-radius": ["interpolate", ["linear"], ["zoom"], 5, 4, 10, 8],
          "circle-color": "#c8962d",
          "circle-stroke-width": 1.5,
          "circle-stroke-color": "#3d2b1f",
          "circle-opacity": 0.85,
        },
      });

      map.on("click", "constituency-dots", (e) => {
        if (e.features && e.features.length > 0) {
          const props = e.features[0].properties;
          const slug = props.slug;
          window.location.href = `/representatives/${slug}`;
        }
      });

      map.on("mouseenter", "constituency-dots", () => {
        map.getCanvas().style.cursor = "pointer";
      });

      map.on("mouseleave", "constituency-dots", () => {
        map.getCanvas().style.cursor = "";
      });

      // Show popup on hover
      const popup = new maplibregl.Popup({
        closeButton: false,
        closeOnClick: false,
      });

      map.on("mousemove", "constituency-dots", (e) => {
        if (e.features && e.features.length > 0) {
          const props = e.features[0].properties;
          const coords = (e.features[0].geometry as GeoJSON.Point).coordinates.slice() as [number, number];
          popup
            .setLngLat(coords)
            .setHTML(
              `<div style="font-family: Inter, sans-serif; font-size: 13px; line-height: 1.4;">
                <strong>${props.candidate}</strong><br/>
                <span style="color: #7a6b60;">${props.location}, ${props.region}</span><br/>
                <span style="color: #5a6e3c;">${props.party}</span>
              </div>`
            )
            .addTo(map);
        }
      });

      map.on("mouseleave", "constituency-dots", () => {
        popup.remove();
      });
    });
  }
</script>
