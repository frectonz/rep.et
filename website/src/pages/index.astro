---
import Layout from "../layouts/Layout.astro";
import GeolocateButton from "../components/GeolocateButton.astro";
import { representatives, regions, parties, totalVotes } from "../lib/data";
import {
  Users,
  MapPinned,
  Vote,
  Search,
  Globe,
  Landmark,
  Map,
} from "@lucide/astro";
---

<Layout>
  <section class="max-w-3xl mx-auto px-4 pt-12 pb-8">
    <div class="text-center mb-10">
      <p class="text-5xl opacity-10 select-none mb-2" aria-hidden="true">ኢ</p>
      <h1 class="text-3xl md:text-4xl font-bold mb-3">Find Your Representative</h1>
      <p class="text-text-muted text-lg">
        Discover who represents your constituency in the<br />
        House of Peoples' Representatives.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <GeolocateButton />
      <a
        href="/map"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-primary hover:bg-primary-light text-white font-semibold rounded-lg transition-colors text-lg"
      >
        <Map class="w-5 h-5" />
        Explore the Map
      </a>
    </div>

    <div id="geo-status" class="mt-4 text-sm text-center hidden"></div>

    <div id="geo-fallback" class="hidden mt-6 max-w-lg mx-auto">
      <div class="bg-callout-bg border-l-4 border-callout-border rounded-r-lg p-4">
        <p class="text-sm text-text-muted mb-3">
          Could not access your location. You can search for your constituency or browse by region instead.
        </p>
        <input
          type="text"
          id="fallback-search"
          placeholder="Search constituency or region..."
          class="w-full px-4 py-2.5 rounded-lg border border-border bg-card text-text placeholder-text-muted focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent"
        />
        <div id="fallback-results" class="mt-2 space-y-1"></div>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-8">
    <div class="grid grid-cols-3 gap-4 text-center">
      <div class="bg-card rounded-lg border border-border p-4">
        <Users class="w-5 h-5 mx-auto mb-1 text-accent" />
        <p class="text-2xl md:text-3xl font-bold font-heading text-primary">{representatives.length}</p>
        <p class="text-sm text-text-muted">Representatives</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4">
        <Globe class="w-5 h-5 mx-auto mb-1 text-accent" />
        <p class="text-2xl md:text-3xl font-bold font-heading text-primary">{regions.length}</p>
        <p class="text-sm text-text-muted">Regions</p>
      </div>
      <div class="bg-card rounded-lg border border-border p-4">
        <Vote class="w-5 h-5 mx-auto mb-1 text-accent" />
        <p class="text-2xl md:text-3xl font-bold font-heading text-primary">{(totalVotes / 1_000_000).toFixed(1)}M</p>
        <p class="text-sm text-text-muted">Total Votes</p>
      </div>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-8">
    <h2 class="text-xl font-bold mb-4">Browse</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/representatives"
        class="bg-card rounded-lg border border-border p-5 hover:border-accent transition-colors group"
      >
        <Search class="w-5 h-5 text-accent mb-2" />
        <h3 class="font-semibold text-primary group-hover:text-accent transition-colors">
          All Representatives
        </h3>
        <p class="text-sm text-text-muted mt-1">
          Search and filter all {representatives.length} elected members
        </p>
      </a>
      <a
        href="/regions"
        class="bg-card rounded-lg border border-border p-5 hover:border-accent transition-colors group"
      >
        <Globe class="w-5 h-5 text-accent mb-2" />
        <h3 class="font-semibold text-primary group-hover:text-accent transition-colors">
          Browse by Region
        </h3>
        <p class="text-sm text-text-muted mt-1">
          Explore constituencies across {regions.length} regions
        </p>
      </a>
      <a
        href="/parties"
        class="bg-card rounded-lg border border-border p-5 hover:border-accent transition-colors group"
      >
        <Landmark class="w-5 h-5 text-accent mb-2" />
        <h3 class="font-semibold text-primary group-hover:text-accent transition-colors">
          Party Breakdown
        </h3>
        <p class="text-sm text-text-muted mt-1">
          See seat distribution among {parties.length} parties
        </p>
      </a>
      <a
        href="/map"
        class="bg-card rounded-lg border border-border p-5 hover:border-accent transition-colors group"
      >
        <Map class="w-5 h-5 text-accent mb-2" />
        <h3 class="font-semibold text-primary group-hover:text-accent transition-colors">
          Interactive Map
        </h3>
        <p class="text-sm text-text-muted mt-1">
          View all constituencies on a map of Ethiopia
        </p>
      </a>
    </div>
  </section>
</Layout>
